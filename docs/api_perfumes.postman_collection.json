          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Demo API Evaluacion 3\",\n  \"categoria\": \"Unisex\",\n  \"precio\": \"12000\",\n  \"ml\": 50,\n  \"en_stock\": true,\n  \"destacado\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
              "if (pm.response.code === 201) {",
              "pm.collectionVariables.set(\"perfume_id\", pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
