{
  "info": {
    "name": "Parfums - Evaluacion 3 API REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con usuario administrador local. Crea y elimina un perfume de demostracion. No compartir credenciales ni tokens reales."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "perfume_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Obtener token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/token/",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
              "if (pm.response.code === 200) {",
              "const body = pm.response.json(); pm.collectionVariables.set(\"access_token\", body.access); pm.collectionVariables.set(\"refresh_token\", body.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET sin token: politica privada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/perfumes/",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET autorizado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/perfumes/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
